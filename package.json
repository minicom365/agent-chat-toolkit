{
  "name": "copilot-transcript-stats",
  "version": "0.2.0",
  "description": "Zero-dependency CLI to analyse and navigate agent conversations kept by VS Code Copilot Chat and Antigravity: statistics, tool usage, effective development time and conversation migration.",
  "keywords": [
    "copilot",
    "copilot-chat",
    "antigravity",
    "vscode",
    "transcript",
    "jsonl",
    "agent",
    "cli",
    "statistics",
    "time-tracking",
    "conversation-history"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "transcript-stats": "bin/transcript-stats.js"
  },
  "main": "src/index.js",
  "files": [
    "bin",
    "src",
    "docs",
    "tools",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/transcript-stats.js",
    "test": "node --test \"test/**/*.test.js\"",
    "sandbox": "node tools/sandbox-e2e.mjs",
    "sandbox:make": "node tools/make-sandbox.mjs --out .sandbox --force",
    "verify": "npm test && npm run sandbox"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/minicom365/copilot-transcript-stats.git"
  },
  "bugs": {
    "url": "https://github.com/minicom365/copilot-transcript-stats/issues"
  },
  "homepage": "https://github.com/minicom365/copilot-transcript-stats#readme"
}
