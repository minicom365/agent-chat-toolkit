# Sandbox verification image.
#
# Runs the unit suite and the end-to-end sandbox checks inside a throwaway Linux
# container, on a Node version that is not the developer's. Nothing is mounted
# from the host, so no editor profile can be reached even by accident:
#
#   docker build -f Dockerfile.verify -t transcript-stats-verify .
#   docker run --rm transcript-stats-verify
#
# The project has no runtime dependencies, so the build needs no npm install.
FROM node:24-alpine

WORKDIR /work
ENV NODE_ENV=production \
    NO_COLOR=1

COPY package.json ./
COPY bin ./bin
COPY src ./src
COPY test ./test
COPY tools ./tools
COPY docs ./docs
COPY README.md README.ko.md LICENSE ./

# Fail the image build if the tool cannot even report its own version.
RUN node --version && node bin/transcript-stats.js --version

CMD ["sh", "-lc", "npm test && node tools/sandbox-e2e.mjs"]
